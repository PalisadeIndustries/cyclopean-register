# Text sources
*.toml   text eol=lf
*.tsv    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.scar   text eol=crlf
*.lua    text eol=crlf
*.module text eol=crlf
*.ps1    text eol=crlf

# Relic binaries (small, keep in git but never diff/merge)
*.rgd binary
*.ucs binary

# Art and audio go through Git LFS
*.rgm   filter=lfs diff=lfs merge=lfs -text
*.rgo   filter=lfs diff=lfs merge=lfs -text
*.rtx   filter=lfs diff=lfs merge=lfs -text
*.rsh   filter=lfs diff=lfs merge=lfs -text
*.dds   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.max   filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.fda   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.sga   filter=lfs diff=lfs merge=lfs -text
